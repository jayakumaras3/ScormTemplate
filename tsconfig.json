{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "outDir": "./dist/out-tsc",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "src/*": ["*"],
      "@app/*": ["app/*"],
      "@core/*": ["app/core/*"],
      "@features/*": ["app/features/*"],
      "@models/*": ["app/core/models/*"],
      "@services/*": ["app/core/services/*"]
    }
  },
  "angularCompilerOptions": {
    "enableIvy": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.html",
    "src/**/*.scss"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}